<style is:global>
    :root {
        --bg: #000000;
        --fg: #ffffff;
        --fg-dim: #a3a3a3;
        --blue: #60a5fa;
    }

    html {
        background: var(--bg);
        color: var(--fg);
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
    }

    ::-webkit-scrollbar {
        width: 8px;
    }
    ::-webkit-scrollbar-track {
        background: var(--bg);
    }
    ::-webkit-scrollbar-thumb {
        background: #262626;
        border-radius: 4px;
    }

    a {
        text-decoration: none;
        transition: color 0.2s;
    }

    code {
        font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
            "Liberation Mono", "Courier New", monospace;
    }

    pre {
        padding: 1rem;
        border-radius: 0.5rem;
        background-color: #171717 !important;
        border: 1px solid #262626;
    }

    .proof, .solution {
        margin: 1.5rem 0;
        padding: 1rem 1.25rem 1rem 1.25rem;
        border-left: 3px solid var(--blue);
        background: rgba(96, 165, 250, 0.04);
        border-radius: 0 0.375rem 0.375rem 0;
        font-style: italic;
        position: relative;
    }

    .proof::before {
        content: "Proof. ";
        font-weight: 600;
        font-style: normal;
    }

    .solution::before {
        content: "Solution. ";
        font-weight: 600;
        font-style: normal;
    }

    .proof::after, .solution::after {
        content: "∎";
        position: absolute;
        bottom: 0.5rem;
        right: 0.75rem;
        font-size: 1.1em;
        font-style: normal;
    }
</style>
